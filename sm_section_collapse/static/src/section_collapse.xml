<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='!isInvisible']" position="after">
            <span t-if="smShowToggle and smShowToggle(record, column)"
                  class="o_sm_section_toggle float-end text-nowrap fw-normal"
                  t-on-click.stop.prevent="() => this.smToggleSection(record)">
                <span class="text-muted me-3" t-out="smItemCountLabel(record)"/>
                <a href="#" t-out="smToggleLabel(record)"/>
            </span>
        </xpath>
    </t>
</templates>
